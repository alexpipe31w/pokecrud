# Plantilla SIN valores. Copiar como `server/.env` (está en .gitignore) y poner la contraseña
# que Alex pasa por privado. Ver docs/plan/SECRETOS.md.
# Supabase pokecrud-go (ref ggfnjophcsyawltmoseh, sa-east-1). Misma contraseña en las dos, cambia el PUERTO:
#  - DATABASE_URL → transaction pooler (6543): la usa la app. El session pooler (5432) solo admite 15 clientes EN TOTAL
#    entre Render y los servidores locales de todos (EMAXCONNSESSION → 500). F0-10, D-021.
#  - DIRECT_URL → session pooler (5432): solo la CLI de Prisma (migraciones necesitan modo sesión). D-017.
DATABASE_URL="postgresql://postgres.ggfnjophcsyawltmoseh:CONTRASENA@aws-1-sa-east-1.pooler.supabase.com:6543/postgres"
DIRECT_URL="postgresql://postgres.ggfnjophcsyawltmoseh:CONTRASENA@aws-1-sa-east-1.pooler.supabase.com:5432/postgres"

# Servidor (no son secretos). En Render: NODE_ENV=production y CORS_ORIGINS con los orígenes de la app.
PORT=3000
CORS_ORIGINS=http://localhost:8100,http://localhost:4200,https://localhost

# Auth (F0-07). JWT_SECRET: ≥ 32 caracteres aleatorios, DISTINTO en cada entorno (local / Render). Generarlo con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET="GENERAR-UNO-PROPIO"
JWT_TTL=900

# Spawns (F1-06, D-025): secreto de la semilla de los Pokémon salvajes. ≥ 32 caracteres aleatorios, DISTINTO en cada
# entorno (mismo comando que JWT_SECRET). Si cambia, cambian todos los spawns. Sin ella, /spawns responde 503.
SPAWN_SALT="GENERAR-UNO-PROPIO"
REFRESH_TTL_DAYS=30
