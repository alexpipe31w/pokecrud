# Plantilla SIN valores. Copiar como `server/.env` (está en .gitignore) y poner la contraseña
# que Alex pasa por privado. Ver docs/plan/SECRETOS.md.
# Supabase pokecrud-go (ref ggfnjophcsyawltmoseh, sa-east-1). Session pooler (IPv4).
DATABASE_URL="postgresql://postgres.ggfnjophcsyawltmoseh:CONTRASENA@aws-1-sa-east-1.pooler.supabase.com:5432/postgres"
DIRECT_URL="postgresql://postgres.ggfnjophcsyawltmoseh:CONTRASENA@aws-1-sa-east-1.pooler.supabase.com:5432/postgres"

# Servidor (no son secretos). En Render: NODE_ENV=production y CORS_ORIGINS con los orígenes de la app.
PORT=3000
CORS_ORIGINS=http://localhost:8100,http://localhost:4200,https://localhost

# Auth (F0-07). JWT_SECRET: ≥ 32 caracteres aleatorios, DISTINTO en cada entorno (local / Render). Generarlo con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET="GENERAR-UNO-PROPIO"
JWT_TTL=900
REFRESH_TTL_DAYS=30
