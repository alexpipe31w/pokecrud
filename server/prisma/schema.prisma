// Esquema de PokéCRUD GO (docs/plan/ARQUITECTURA.md). Toda modificación va con su migración:
// `npm run db:migrate -- --name <cambio>` (nunca tocar la base a mano).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Player {
  id            String         @id @default(uuid()) @db.Uuid
  email         String         @unique
  passwordHash  String
  nickname      String         @unique
  level         Int            @default(1)
  xp            Int            @default(0)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  refreshTokens RefreshToken[]
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  playerId  String    @db.Uuid
  player    Player    @relation(fields: [playerId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  familyId  String    @db.Uuid
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([playerId])
  @@index([familyId])
}
