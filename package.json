{
  "name": "pokecrud",
  "version": "0.1.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "seed:151": "node scripts/seed-151.mjs",
    "dataset": "node scripts/build-dataset.mjs",
    "test:shared": "vitest run --config vitest.shared.config.ts",
    "test:all": "ng test --watch=false && npm run test:shared",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "lint": "ng lint",
    "format": "prettier --write \"src/**/*.{ts,html,scss}\" \"backend/**/*.json\"",
    "format:check": "prettier --check \"src/**/*.{ts,html,scss}\" \"backend/**/*.json\"",
    "apk": "node scripts/apk.mjs"
  },
  "private": true,
  "dependencies": {
    "@angular/common": "22.1.7",
    "@angular/compiler": "22.1.7",
    "@angular/core": "22.1.7",
    "@angular/forms": "22.1.7",
    "@angular/platform-browser": "22.1.7",
    "@angular/router": "22.1.7",
    "@aparajita/capacitor-secure-storage": "8.0.1",
    "@capacitor/android": "8.5.2",
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8.5.2",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/keyboard": "^8.0.5",
    "@capacitor/splash-screen": "8.0.2",
    "@capacitor/status-bar": "^8.0.3",
    "@fontsource/fredoka": "5.3.0",
    "@ionic/angular": "^9.0.0",
    "idb": "8.0.4",
    "ionicons": "^8.1.0",
    "rxjs": "~7.8.0",
    "three": "0.186.1",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "22.1.8",
    "@angular/cli": "22.1.8",
    "@angular/compiler-cli": "22.1.7",
    "@angular/language-service": "22.1.7",
    "@capacitor/cli": "^8.5.2",
    "@ionic/angular-toolkit": "^13.0.0",
    "@types/node": "^24.19.2",
    "@types/three": "0.186.0",
    "angular-eslint": "22.0.0",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "fake-indexeddb": "6.2.5",
    "jsdom": "^26.0.0",
    "prettier": "^3.9.9",
    "typescript": "~6.0.0",
    "typescript-eslint": "^8.61.0",
    "vitest": "~4.0.18"
  },
  "description": "PokéCRUD - App Angular + Ionic que consume PokéAPI y un backend propio con JSON Server"
}
